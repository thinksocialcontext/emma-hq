# Copy to .env (./setup.sh does this) and fill in only what you use.
# .env is ignored by git. Never paste these values into a chat, a brief, a memory or the ledger.

# Shopify Admin API, read scopes first (Settings > Apps and sales channels > Develop apps)
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=

# Meta Marketing API, read only (ads_read) for the dashboard numbers. Steps: docs/connect-meta.md
# Test with: python3 ads/tools/meta_pull.py --check
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=

# Klaviyo private API key, read scopes for reporting
KLAVIYO_API_KEY=

# Dashboard
HQ_DASHBOARD_PORT=8765

# Force a backend for scripts/hq: herdr or tmux (blank means herdr if installed)
HQ_BACKEND=
