#!/usr/bin/env bash
# hq: one set of verbs for the Emma HQ agents, on herdr or on tmux.
#
#   hq start                 open the HQ layout (manager, ads, social, shopify, email)
#   hq list [--json]         every agent and its state
#   hq read NAME [LINES]     the last lines of an agent's screen
#   hq prompt NAME "TEXT"    type a task into an agent and press Enter
#   hq wait NAME [SECONDS]   wait until the agent stops working (or asks a question)
#   hq attach                look at the tmux session (tmux backend only)
#   hq stop                  close the HQ tmux session (tmux backend only, asks first)
#   hq backend               print which backend is in use
#
# Backend: HQ_BACKEND=herdr or tmux. Default is herdr when it is installed, else tmux.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
AGENTS=(hq ads social shopify email)
SESSION="${HQ_TMUX_SESSION:-emma-hq}"
AGENT_CMD="${HQ_AGENT_CMD-claude}"
AGENT_KIND="${HQ_AGENT_KIND:-claude}"

die() { echo "hq: $*" >&2; exit 1; }

backend() {
  if [[ -n "${HQ_BACKEND:-}" ]]; then echo "$HQ_BACKEND"; return; fi
  if command -v herdr >/dev/null 2>&1; then echo herdr; else echo tmux; fi
}

folder_for() {
  case "$1" in
    hq) echo "$ROOT" ;;
    ads|social|shopify|email) echo "$ROOT/$1" ;;
    *) die "unknown agent '$1' (expected: ${AGENTS[*]})" ;;
  esac
}

# ---------- tmux backend ----------
T() { if [[ -n "${HQ_TMUX_SOCKET:-}" ]]; then tmux -L "$HQ_TMUX_SOCKET" "$@"; else tmux "$@"; fi; }

t_has_session() { T has-session -t "=$SESSION" 2>/dev/null; }

t_target() {
  t_has_session || die "HQ is not running. Run: scripts/hq start"
  T list-windows -t "=$SESSION" -F '#{window_name}' | grep -qx "$1" || die "no agent named '$1'"
  echo "=$SESSION:$1"
}

t_snapshot() { T capture-pane -p -J -t "$1" -S "-${2:-200}" 2>/dev/null; }

# A question or permission dialog on screen means the human must answer it.
t_is_blocked() {
  tail -n 25 <<<"$1" | grep -Eq 'Do you want to|Would you like to|\(y/n\)|\[Y/n\]|❯ 1\. Yes|Allow once|Press Enter to continue|Enter to confirm|Esc to cancel'
}

# Text already typed in the input box, not yet sent.
t_has_typed_input() {
  tail -n 8 <<<"$1" | grep -Eq '^[│|] > [^ ]|^> [^ ]'
}

t_state() {  # name, prints idle|working|blocked using two snapshots
  local tgt a b
  tgt="=$SESSION:$1"
  a="$(t_snapshot "$tgt" 60)"
  sleep "${HQ_STATE_SAMPLE:-1}"
  b="$(t_snapshot "$tgt" 60)"
  if t_is_blocked "$b"; then echo blocked
  elif [[ "$a" != "$b" ]]; then echo working
  else echo idle; fi
}

t_start() {
  command -v tmux >/dev/null 2>&1 || die "tmux is not installed. Run ./setup.sh"
  if t_has_session; then echo "HQ is already running in tmux session '$SESSION'. Use: scripts/hq attach"; return; fi
  local first=1 name dir
  for name in "${AGENTS[@]}"; do
    dir="$(folder_for "$name")"
    if (( first )); then
      T new-session -d -s "$SESSION" -n "$name" -c "$dir" -x 220 -y 50
      first=0
    else
      T new-window -d -t "=$SESSION:" -n "$name" -c "$dir"
    fi
    T set-option -t "=$SESSION:$name" automatic-rename off >/dev/null
    [[ -n "$AGENT_CMD" ]] && T send-keys -t "=$SESSION:$name" -l "$AGENT_CMD" && T send-keys -t "=$SESSION:$name" Enter
  done
  echo "HQ started in tmux session '$SESSION' with windows: ${AGENTS[*]}"
  echo "Look at it with: scripts/hq attach   (switch windows with Ctrl+b then the window number)"
}

t_list() {
  local json="${1:-}" name cmd
  t_has_session || { [[ "$json" == --json ]] && echo '[]' || echo "HQ is not running."; return 0; }
  local names; names="$(T list-windows -t "=$SESSION" -F '#{window_name}')"
  local -A first=() second=()
  for name in $names; do first[$name]="$(t_snapshot "=$SESSION:$name" 60)"; done
  sleep "${HQ_STATE_SAMPLE:-1}"
  local rows=()
  for name in $names; do
    second[$name]="$(t_snapshot "=$SESSION:$name" 60)"
    local state=idle
    if t_is_blocked "${second[$name]}"; then state=blocked
    elif [[ "${first[$name]}" != "${second[$name]}" ]]; then state=working; fi
    cmd="$(T display-message -p -t "=$SESSION:$name" '#{pane_current_command}')"
    rows+=("$name"$'\t'"$state"$'\t'"$cmd")
  done
  if [[ "$json" == --json ]]; then
    printf '%s\n' "${rows[@]}" | python3 -c 'import json,sys
print(json.dumps([dict(zip(("name","state","detail"),l.rstrip("\n").split("\t"))) for l in sys.stdin if l.strip()]))'
  else
    printf '%-10s %-9s %s\n' NAME STATE PROCESS
    printf '%s\n' "${rows[@]}" | awk -F'\t' '{printf "%-10s %-9s %s\n",$1,$2,$3}'
  fi
}

t_read() { local tgt; tgt="$(t_target "$1")"; t_snapshot "$tgt" "${2:-120}" | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' | tail -n "${2:-120}"; }

t_prompt() {
  local tgt screen; tgt="$(t_target "$1")"; shift
  [[ $# -ge 1 && -n "$1" ]] || die "nothing to send"
  screen="$(t_snapshot "$tgt" 40)"
  if t_is_blocked "$screen"; then die "'${tgt##*:}' is showing a question or permission dialog. A human must answer it first. Run: scripts/hq read ${tgt##*:}"; fi
  if [[ "${HQ_FORCE:-0}" != 1 ]] && t_has_typed_input "$screen"; then
    die "'${tgt##*:}' already has unsent text in its input box. Not adding to it. Run: scripts/hq read ${tgt##*:}"
  fi
  T send-keys -t "$tgt" -l "$1"
  sleep 0.3
  T send-keys -t "$tgt" Enter
  echo "sent to ${tgt##*:}"
}

t_wait() {
  local tgt timeout quiet elapsed=0 still=0 prev cur
  tgt="$(t_target "$1")"; timeout="${2:-600}"; quiet="${HQ_QUIET_SECONDS:-5}"
  prev="$(t_snapshot "$tgt" 60)"
  while (( elapsed < timeout )); do
    sleep 1; elapsed=$((elapsed + 1))
    cur="$(t_snapshot "$tgt" 60)"
    if t_is_blocked "$cur"; then echo blocked; return 0; fi
    if [[ "$cur" == "$prev" ]]; then still=$((still + 1)); else still=0; prev="$cur"; fi
    if (( still >= quiet )); then echo idle; return 0; fi
  done
  echo timeout; return 2
}

t_stop() {
  t_has_session || { echo "HQ is not running."; return; }
  if [[ "${HQ_YES:-0}" != 1 ]]; then
    read -r -p "Close every HQ window, including any agent still working? [y/N] " ok
    [[ "$ok" =~ ^[Yy]$ ]] || { echo "Left running."; return; }
  fi
  T kill-session -t "=$SESSION"; echo "HQ stopped."
}

# ---------- herdr backend ----------
h_json_id() {  # read an id out of a herdr JSON reply: h_json_id '<json>' path.to.obj
  python3 -c 'import json,sys
d=json.loads(sys.argv[1])
for k in sys.argv[2].split("."):
    d=d.get(k) if isinstance(d,dict) else None
if isinstance(d,dict):
    d=d.get("pane_id") or d.get("workspace_id") or d.get("tab_id") or d.get("id")
print(d or "")' "$1" "$2"
}

h_agent_names() {
  herdr agent list 2>/dev/null | python3 -c 'import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
items=d.get("result",d) if isinstance(d,dict) else d
if isinstance(items,dict): items=items.get("agents",[])
for a in items or []:
    n=a.get("name") or a.get("agent_name")
    if n: print(n)'
}

h_start() {
  herdr status server >/dev/null 2>&1 || die "herdr is not running. Open a terminal, run 'herdr', then run scripts/hq start from inside it."
  if h_agent_names | grep -qx hq; then echo "HQ is already running in herdr. Run: scripts/hq list"; return; fi
  local reply ws pane name
  reply="$(herdr workspace create --cwd "$ROOT" --label "Emma HQ" --no-focus)"
  ws="$(h_json_id "$reply" result.workspace)"; pane="$(h_json_id "$reply" result.root_pane)"
  [[ -n "$ws" && -n "$pane" ]] || die "could not read the new workspace from herdr: $reply"
  herdr pane rename "$pane" HQ >/dev/null || true
  herdr agent start hq --kind "$AGENT_KIND" --pane "$pane" >/dev/null
  for name in ads social shopify email; do
    reply="$(herdr tab create --workspace "$ws" --cwd "$ROOT/$name" --label "${name^}" --no-focus)"
    pane="$(h_json_id "$reply" result.root_pane)"
    [[ -n "$pane" ]] || die "could not read the new tab for $name: $reply"
    herdr agent start "$name" --kind "$AGENT_KIND" --pane "$pane" >/dev/null
  done
  echo "HQ started in herdr workspace 'Emma HQ' with agents: ${AGENTS[*]}"
}

h_list() {
  if [[ "${1:-}" == --json ]]; then
    herdr agent list | python3 -c 'import json,sys
d=json.load(sys.stdin)
items=d.get("result",d) if isinstance(d,dict) else d
if isinstance(items,dict): items=items.get("agents",[])
out=[]
for a in items or []:
    out.append({"name":a.get("name") or a.get("agent_name") or a.get("pane_id",""),
                "state":a.get("state") or a.get("status") or "unknown",
                "detail":a.get("kind") or a.get("agent") or ""})
print(json.dumps(out))'
  else
    herdr agent list
  fi
}

# ---------- dispatch ----------
cmd="${1:-help}"; shift || true
B="$(backend)"
case "$B:$cmd" in
  *:backend) echo "$B" ;;
  tmux:start) t_start ;;
  tmux:list) t_list "${1:-}" ;;
  tmux:read) [[ $# -ge 1 ]] || die "usage: hq read NAME [LINES]"; t_read "$@" ;;
  tmux:prompt) [[ $# -ge 2 ]] || die 'usage: hq prompt NAME "TEXT"'; t_prompt "$1" "$2" ;;
  tmux:wait) [[ $# -ge 1 ]] || die "usage: hq wait NAME [SECONDS]"; t_wait "$@" ;;
  tmux:attach) t_has_session || die "HQ is not running"; T attach -t "=$SESSION" ;;
  tmux:stop) t_stop ;;
  herdr:start) h_start ;;
  herdr:list) h_list "${1:-}" ;;
  herdr:read) [[ $# -ge 1 ]] || die "usage: hq read NAME [LINES]"; herdr agent read "$1" --source recent-unwrapped --lines "${2:-120}" ;;
  herdr:prompt) [[ $# -ge 2 ]] || die 'usage: hq prompt NAME "TEXT"'
    if [[ "${HQ_FORCE:-0}" != 1 ]] && t_has_typed_input "$(herdr agent read "$1" --source visible 2>/dev/null)"; then
      die "'$1' already has unsent text in its input box. Not adding to it. Run: scripts/hq read $1"
    fi
    herdr agent prompt "$1" "$2" ;;
  herdr:wait) [[ $# -ge 1 ]] || die "usage: hq wait NAME [SECONDS]"; herdr agent wait "$1" --timeout "$(( ${2:-600} * 1000 ))" ;;
  herdr:attach|herdr:stop) die "with herdr, use the herdr window itself to look at or close the workspace" ;;
  *:help|*:-h|*:--help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command '$cmd'. Run: scripts/hq help" ;;
esac
